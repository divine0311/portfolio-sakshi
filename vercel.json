{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:path*",
      "destination": "/blog/:path*/index.html"
    },
    {
      "source": "/ai-developer",
      "destination": "/ai-developer.html"
    },
    {
      "source": "/ai-developer/",
      "destination": "/ai-developer.html"
    },
    {
      "source": "/digital-marketer",
      "destination": "/digital-marketer.html"
    },
    {
      "source": "/digital-marketer/",
      "destination": "/digital-marketer.html"
    },
    {
      "source": "/editor",
      "destination": "/editor.html"
    },
    {
      "source": "/editor/",
      "destination": "/editor.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ]
}