      let phraseIdx = 0;
      let charIdx = phrases[0].length;
      let isDeleting = false;
      const typeSpeed = 75;
      const deleteSpeed = 40;
      const pauseEnd = 2000; // pauses ~2s at completion

      function stepTypewriter() {
        const currentPhrase = phrases[phraseIdx];

        if (isDeleting) {
          charIdx--;
          typewriterElem.textContent = currentPhrase.substring(0, charIdx);
          if (charIdx <= 0) {
            isDeleting = false;
            phraseIdx = (phraseIdx + 1) % phrases.length;
            setTimeout(stepTypewriter, 350);
            return;
          }
          setTimeout(stepTypewriter, deleteSpeed);
        } else {
          charIdx++;
          typewriterElem.textContent = currentPhrase.substring(0, charIdx);
          if (charIdx === currentPhrase.length) {
            isDeleting = true;
            setTimeout(stepTypewriter, pauseEnd);
            return;
          }
          setTimeout(stepTypewriter, typeSpeed);
        }
      }

      // Start typewriter after welcome reveal
      setTimeout(stepTypewriter, 2600);

      // 3. SCROLL REVEAL ANIMATIONS (Intersection Observer)
      const revealElements = document.querySelectorAll('.reveal-on-scroll');
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(function (entries, observer) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px'
        });

        revealElements.forEach(function (el) {
          revealObserver.observe(el);
        });
      } else {
        revealElements.forEach(function (el) {
          el.classList.add('is-visible');
        });
      }

      // 4. FLOATING NAVBAR ACTIVE SECTION DETECTION
      // Section IDs matching navbar exactly: #home, #my-story, #journey, #capabilities, #vision, #connect
      const sectionIds = ['home', 'my-story', 'journey', 'capabilities', 'vision', 'connect'];
      const navButtons = document.querySelectorAll('.nav-pill-btn[data-target]');

      function setActiveNav(targetId) {
        navButtons.forEach(function (btn) {
          if (btn.getAttribute('data-target') === targetId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }

      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              const currentId = entry.target.getAttribute('id');
              if (currentId) {
                setActiveNav(currentId);
              }
            }
          });
        }, {
          threshold: 0.35,
          rootMargin: '-10% 0px -40% 0px'
        });

        sectionIds.forEach(function (id) {
          const sectionEl = document.getElementById(id);
          if (sectionEl) {
            sectionObserver.observe(sectionEl);
          }
        });
      }

      // 5. VIDEO PLAYBACK: CONTINUOUS SEAMLESS LOOP ON RIGHT SIDE
      const heroVideo = document.getElementById('hero-video');
      if (heroVideo) {
        heroVideo.muted = true;
        heroVideo.loop = true;
        heroVideo.setAttribute('playsinline', '');

        heroVideo.addEventListener('playing', function () {
          heroVideo.classList.add('is-active');
        });

        heroVideo.addEventListener('ended', function () {
          heroVideo.currentTime = 0;
          heroVideo.play().catch(function () {});
        });

        const playPromise = heroVideo.play();
        if (playPromise !== undefined) {
          playPromise.then(function () {
            heroVideo.classList.add('is-active');
          }).catch(function () {
            // If autoplay is delayed, GIF fallback animates seamlessly
          });
        }
      }

      // Dynamic year in footer
      const yearEl = document.getElementById('current-year');
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }

    })();

    // 6. FORM SUBMISSION INTERACTION
    function handleFormSubmit(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-btn');
      const feedback = document.getElementById('form-feedback');
      const form = document.getElementById('contact-form');

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Sending Message...</span>';
      }

      setTimeout(function () {
        if (feedback) {
          feedback.style.display = 'block';
        }
        if (submitBtn) {
          submitBtn.innerHTML = '<span>Message Sent!</span>';
          submitBtn.style.backgroundColor = '#2E7D32';
          submitBtn.style.color = '#FFFFFF';
        }
        form.reset();
        setTimeout(function () {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Message</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>';
            submitBtn.style.backgroundColor = '';
            submitBtn.style.color = '';
          }
        }, 4000);
      }, 700);
    }
  </script>

